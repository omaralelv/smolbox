# Copia este archivo como .env en cada computadora o servidor.
# Despues llena tus claves reales en .env, no en este archivo.
# El archivo .env no debe subirse a GitHub.

APP_NAME=Smolbox
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://smolbox:smolbox@db:5432/smolbox
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
CFDI_RECEIVER_RFC=
# En produccion/VM agrega aqui la URL del front para que el navegador pueda llamar al backend.
# Ejemplo: CORS_ALLOWED_ORIGINS=["http://192.168.1.50"]
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AWS Textract OCR
# Para activar OCR:
# 1. Cambia TEXTRACT_ENABLED=true en tu .env.
# 2. Reemplaza las claves de ejemplo por tus claves reales de AWS.
# 3. AWS_SESSION_TOKEN solo se llena si AWS te dio una llave temporal.
TEXTRACT_ENABLED=false
TEXTRACT_STORE_RAW_RESPONSE=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=pon_aqui_tu_access_key
AWS_SECRET_ACCESS_KEY=pon_aqui_tu_secret_key
AWS_SESSION_TOKEN=

AUTO_CREATE_SCHEMA=false

# Importacion inicial de tiendas y usuarios desde app/assets/Copia de BASE DE TIENDAS.xlsx
# En Render activalo solo para poblar la base por primera vez. Despues regresalo a false.
IMPORT_INITIAL_CATALOG=false
INITIAL_CATALOG_PASSWORD=pon_aqui_una_contrasena_temporal

# Importacion opcional de cortes iniciales por tienda.
# Activala solo una vez en Render y despues regresala a false.
IMPORT_OPENING_CUTOFFS=false
OPENING_CUTOFFS_STARTS_ON=2026-07-01
OPENING_CUTOFFS_ENDS_ON=2026-07-31
OPENING_CUTOFFS_AMOUNT=0.00
OPENING_CUTOFFS_NOTES=Corte inicial migrado a Smolbox.
OPENING_CUTOFFS_UPDATE_EXISTING=false

# Importacion opcional del historico de gastos desde app/assets/COPIA SALDO DE TDAS ANOS 24 25 Y 26.xlsx
# Activala solo una vez en Render y despues regresala a false.
IMPORT_SPENDING_BASELINES=false

# Amazon Cognito (leave disabled while using the local login)
COGNITO_ENABLED=false
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/your_user_pool_id
COGNITO_APP_CLIENT_ID=
# Optional; defaults to {COGNITO_ISSUER}/.well-known/jwks.json
COGNITO_JWKS_URL=
